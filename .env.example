# Frontend (set in Vercel)
VITE_API_BASE=https://your-app-name.onrender.com

# ─── Sentry error monitoring (Round 1: Error Monitoring only) ────
# Frontend DSN from the Sentry `meridian-frontend` project.
# When absent, Sentry stays fully disabled (fail-open) — the app is unaffected.
# Never commit a real DSN value; set it in Vercel Project Settings.
VITE_SENTRY_DSN=
# Optional: non-secret release metadata. On Vercel the commit SHA is picked
# up automatically from VERCEL_GIT_COMMIT_SHA (vite.config.ts allowlist) and
# the release derives as meridian@<product-version>+<short-sha> — no manual
# per-deployment var needed. Requires "Enable access to System Environment
# Variables" in Vercel Project Settings → Environment Variables.
# Set VITE_MERIDIAN_COMMIT only to override (non-Vercel builds).
# Set VITE_MERIDIAN_RELEASE only if the build injects the release directly.
VITE_MERIDIAN_COMMIT=
VITE_MERIDIAN_RELEASE=
# Optional: override the Sentry environment label.
# Defaults: Vercel-native VERCEL_ENV (production/preview, automatic) else
# production in prod builds, development locally.
VITE_SENTRY_ENVIRONMENT=
# No SENTRY_AUTH_TOKEN in Round 1 (source-map upload is a later round).

# Backend (set in Render)
NODE_ENV=production
# JWT_SECRET is preferred for signing; SESSION_SECRET is the legacy fallback.
JWT_SECRET=your-64-char-random-string-here
SESSION_SECRET=your-super-secret-random-string-here
FRONTEND_URL=https://your-app-name.vercel.app
