# ─── Legacy sources (disabled by default) ────────────────────────
# Adzuna API (free: 250 calls/month) — https://developer.adzuna.com/
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (free: 500 req/month) — https://rapidapi.com/letswrap-ai/api/jsearch
JSEARCH_ENABLED=false
JSEARCH_API_KEY=

# ─── eFinancialCareers (behind flag) ────────────────────────────
# Undocumented JSON endpoint — test before enabling
EFC_ENABLED=false

# ─── Email (Gmail SMTP for password reset) ──────────────────────
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Scan settings ──────────────────────────────────────────────
# Background scan interval in hours (default: 6)
CRON_INTERVAL_HOURS=6

# ─── Server ─────────────────────────────────────────────────────
PORT=3001

# ─── Auth signing secrets ───────────────────────────────────────
# The server refuses to start unless JWT_SECRET or SESSION_SECRET is set.
JWT_SECRET=your-64-char-random-string-here
SESSION_SECRET=your-super-secret-random-string-here

# ─── Sentry error monitoring (Round 1: Error Monitoring only) ────
# Backend DSN from the Sentry `meridian-api` project.
# When absent, Sentry stays fully disabled (fail-open) — the server is unaffected.
# Never commit a real DSN value; set it in the Render dashboard (meridian service).
SENTRY_DSN=
# Optional: non-secret release metadata. The server prefers Render's native
# RENDER_GIT_COMMIT and derives release as meridian@<product-version>+<short-sha>.
# Set MERIDIAN_COMMIT only to normalize/override the SHA source; set
# MERIDIAN_RELEASE only to pin the full release string explicitly.
MERIDIAN_COMMIT=
MERIDIAN_RELEASE=
# Optional: override the Sentry environment label (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=
# No SENTRY_AUTH_TOKEN in Round 1 (source-map upload is a later round).
