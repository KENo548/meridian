# ─── Legacy sources (disabled by default) ────────────────────────
# Adzuna API (free: 250 calls/month) — https://developer.adzuna.com/
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI (free: 500 req/month) — https://rapidapi.com/letswrap-ai/api/jsearch
JSEARCH_ENABLED=false
JSEARCH_API_KEY=

# ─── eFinancialCareers (behind flag) ────────────────────────────
# Undocumented JSON endpoint — test before enabling
EFC_ENABLED=false

# ─── Email (Gmail SMTP for password reset) ──────────────────────
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Scan settings ──────────────────────────────────────────────
# Background scan interval in hours (default: 6)
CRON_INTERVAL_HOURS=6

# ─── Server ─────────────────────────────────────────────────────
PORT=3001

# ─── Auth signing secrets ───────────────────────────────────────
# The server refuses to start unless JWT_SECRET or SESSION_SECRET is set.
JWT_SECRET=your-64-char-random-string-here
SESSION_SECRET=your-super-secret-random-string-here
